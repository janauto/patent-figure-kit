# 复制为 .env 后填写（.env 已在 .dockerignore 里，不进镜像；不要提交到 git）。
# 生成 token：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WORKBENCH_TOKEN=
# 对外根地址（与 PFK_SITE_ADDRESS 同一个域名；非 443 端口要写上端口）
PFK_PUBLIC_URL=https://pfk.example.com
PFK_SITE_ADDRESS=pfk.example.com
# 浏览器入口 Basic Auth。生成哈希：docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext '你的密码'
# 哈希里有 $，必须用单引号括起来，否则 compose 会把它当变量展开。
PFK_BASIC_USER=pfk
PFK_BASIC_HASH='$2a$14$替换为hash-password的输出'
# 可选：AI 起名（不填 = 不外发任何内容）
DEEPSEEK_API_KEY=
# 可选：端口与内部网段（与宿主机已有网段冲突时改这里，三项要一致）
# PFK_HTTP_PORT=80
# PFK_HTTPS_PORT=443
# PFK_SUBNET=172.30.57.0/24
# PFK_PROXY_IP=172.30.57.10
# PFK_APP_IP=172.30.57.20
# 使用 CI 构建好的镜像（GHCR 推送需手动触发且受外发门禁）：
# PFK_IMAGE=ghcr.io/janauto/patent-figure-kit:0.1.0
