{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/patent-drawing/schemas/figure-plan.schema.json",
  "title": "patent figure plan",
  "description": "The only artefact an LLM is allowed to produce. It carries no coordinates, no text heights and no numerals; every geometric quantity is computed by scripts/patent_figure/*.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "terms", "figures"],
  "properties": {
    "schema": {
      "const": "patent-figure-plan/1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step"],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1,
          "description": "path to the STEP file"
        },
        "include": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "fnmatchcase globs on part name; empty or absent means every part"
        },
        "exclude": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "fnmatchcase globs on part name; applied after include"
        }
      }
    },
    "terms": {
      "type": "array",
      "description": "numeral issue order: terms[0] is numeral 1. The plan never contains numerals.",
      "items": {"$ref": "#/$defs/term"}
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/figure"}
    },
    "layout": {"$ref": "#/$defs/layout"}
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "term"],
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1,
          "description": "fnmatchcase glob on part name; must match at least one part in assembly.json"
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "description": "Chinese technical noun. Must not look like an internal part code."
        },
        "label": {
          "enum": ["once", "all", "none"],
          "default": "once",
          "description": "once = label exactly the instance whose key sorts first; all = every instance; none = no label"
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caption", "kind", "members"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
          "description": "also the output file stem out/<id>.dxf, so it is restricted to filename-safe characters"
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["assembly", "exploded"]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "fnmatchcase globs resolved against the selected parts"
        },
        "layout": {"$ref": "#/$defs/layout"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "view": {
          "enum": ["iso", "front", "back", "right", "left", "top", "bottom"],
          "default": "iso"
        },
        "explode_axis": {
          "enum": ["x", "y", "z", "auto"],
          "default": "auto"
        },
        "axis_angle": {
          "default": "auto",
          "description": "\"auto\" lets the renderer solve the sheet angle per figure in closed form; a number pins it and is clamped to [120, 180].",
          "oneOf": [
            {"const": "auto"},
            {"type": "number", "minimum": 120, "maximum": 180}
          ]
        },
        "density": {
          "enum": ["compact", "normal", "loose"],
          "default": "normal"
        },
        "max_labels_per_figure": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        },
        "engineering_table": {
          "type": "boolean",
          "default": false,
          "description": "off by default; a file produced with it is written as <id>_engineering.dxf and is never a filing copy"
        }
      }
    }
  }
}
